# AEGIS environment — copy to .env.local and fill in.

# HMAC secret for owner control-plane keys. SET A STRONG VALUE IN PROD.
AEGIS_SECRET=change-me-to-a-long-random-string

# HMAC secret for magic-link tokens and session cookies. Separate from the
# key secret so one leak does not expose the other. SET IN PROD.
AEGIS_AUTH_SECRET=change-me-to-another-long-random-string

# Public base URL for magic-link deep links (no trailing slash).
# AEGIS_PUBLIC_URL=https://aegis.example.com

# Ledger: libSQL file, Turso libsql:// URL, or a postgres:// URL.
# AEGIS_DB_URL=file:./data/aegis.db
# AEGIS_DB_URL=postgres://user:pass@host:5432/db

# In-flight revocation window (ms)
AEGIS_HOLD_MS=5000

# Policy changes take effect after this delay (ms)
AEGIS_POLICY_TIMELOCK_MS=0

# Max age of a signed agent request (ms)
AEGIS_SIGNATURE_SKEW_MS=300000

# Owner decision window for high-risk transfers (ms)
AEGIS_STEPUP_TTL_MS=120000

# Circuit breaker: anomalies in window that auto-freeze a wallet
AEGIS_BREAKER_THRESHOLD=5
AEGIS_BREAKER_WINDOW_MS=60000

# Active settlement rail: sandbox | usdc-testnet | ach-lite
AEGIS_RAIL=sandbox
# AEGIS_USDC_RAIL_URL=

# Multi-sig owner key issuance (2-of-3)
AEGIS_MULTISIG_REQUIRED=2
AEGIS_MULTISIG_TTL_MS=600000

# On-chain mirror (optional)
# AEGIS_GUARDIAN_ADDRESS=
# AEGIS_POLICY_REGISTRY=
# AEGIS_RPC_URL=
# AEGIS_CHAIN_NAME=hardhat (local)

# Seal the same policy hash the app reports. Read automatically from
# deployments/sepolia.json when unset (contracts package).
# AEGIS_POLICY_HASH=

# Sepolia deployment (contracts package)
# AEGIS_DEPLOYER_KEY=
# AEGIS_ETHERSCAN_KEY=

# 0 disables demo bootstrap/reset
AEGIS_DEMO_MODE=1

# 1 seeds a demo org/wallet/fake-history on first boot (default: OFF, so a
# production store only ever holds data created through the real API)
# AEGIS_SEED_DEMO=0

# Notification delivery (webhook delivery is always available via prefs):
# AEGIS_WEBHOOK_URL=
# AEGIS_WEBHOOK_SECRET=
# AEGIS_SLACK_URL=https://hooks.slack.com/services/...
# AEGIS_RESEND_API_KEY=re_xxx
# AEGIS_EMAIL_FROM=AEGIS <guard@example.com>
# AEGIS_EMAIL_TO=ops@example.com

# Edge rate limiting (token buckets, in-memory per isolate). Set DISABLED=1
# to turn off (tests / trusted local dev). Defaults: key 60 cap / 10 rps,
# ip 300 cap / 50 rps.
# AEGIS_RL_DISABLED=0
# AEGIS_RL_KEY_CAP=60
# AEGIS_RL_KEY_RPS=10
# AEGIS_RL_IP_CAP=300
# AEGIS_RL_IP_RPS=50

# Request audit logging (B4). 0 disables the per-request auth audit trail.
# AEGIS_REQUEST_AUDIT=1

# Audit retention window for on-chain-style append logs (ms).
# AEGIS_AUDIT_RETENTION_YEARS=

# Outbox event retention (days) before cleanup.
# AEGIS_OUTBOX_RETENTION_DAYS=

# Fees (bps / flat minimum):
# AEGIS_FEE_USDC_BPS=
# AEGIS_FEE_ACH_BPS=
# AEGIS_FEE_FLAT_MIN=

# External AI / KMS / cron (optional):
# AEGIS_LLM_URL=
# AEGIS_LLM_MODEL=
# AEGIS_KMS_URL=
# AEGIS_KMS_MASTER=
# AEGIS_KMS_CACHE_TTL_MS=
# AEGIS_CRON_SECRET=

