# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# runtime data (local libSQL ledger)
/data/

# internal planning docs (never pushed)
/plan.md
/newplan.md
/SESSION.md
/DEMO_SCRIPT.md
/newFeatures.md

# python sdk
__pycache__/
*.pyc
python/*.egg-info/

# hardhat / solidity build artifacts (contracts package)
/contracts/artifacts/
/contracts/cache/
/contracts/typechain-types/
/contracts/node_modules/
/contracts/deployments/

.vercel
